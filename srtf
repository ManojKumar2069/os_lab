#include <stdio.h>
#include <stdlib.h>

struct process
{
    int at;
    int bt;
    int rt;
    int tat;
    int ct;
    int wt;
};

void srjf(struct process p[], int n)
{
    int completed = 0, t = 0;
    int min_rt, idx;
    float total_wt = 0, total_tat = 0;

    while (completed < n)
    {
        min_rt = 999;
        idx = -1;

        // Find process with shortest remaining time at current time
        for (int i = 0; i < n; i++)
        {
            if (p[i].at <= t && p[i].rt > 0)
            {
                if (p[i].rt < min_rt)
                {
                    min_rt = p[i].rt;
                    idx = i;
                }
            }
        }

        if (idx != -1)
        {
            p[idx].rt--;   // Execute process for 1 unit
            t++;           // Advance time

            if (p[idx].rt == 0)  // Process finished
            {
                completed++;
                p[idx].ct = t;
                p[idx].tat = p[idx].ct - p[idx].at;
                p[idx].wt = p[idx].tat - p[idx].bt;
                total_wt += p[idx].wt;
                total_tat += p[idx].tat;
            }
        }
        else
        {
            t++;  // CPU idle, just advance time
        }
    }

    printf("\nID\tAT\tBT\tCT\tWT\tTAT\n");
    for (int i = 0; i < n; i++)
    {
        printf("%d\t%d\t%d\t%d\t%d\t%d\n", i, p[i].at, p[i].bt, p[i].ct, p[i].wt, p[i].tat);
    }
    printf("\nAverage Waiting Time: %.2f", total_wt / n);
    printf("\nAverage Turnaround Time: %.2f\n", total_tat / n);
}

int main()
{
    int n;
    printf("\n Enter how many process ");
    scanf("%d",&n);
    struct process p[n];
    for(int i=0;i<n;i++)
    {
        printf("Enter the at of process %d\n",i+1);
        scanf("%d",&p[i].at);
        printf("Enter the bt of process %d\n",i+1);
        scanf("%d",&p[i].bt);
        p[i].rt=p[i].bt;
    }
    srjf(p,n);
    return 0;
}
